APP_NAME="Crypto Deposit Desk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MySQL (docker compose: host = mysql) -----------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=deposit_desk
DB_USERNAME=deposit
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Redis / очереди --------------------------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="desk@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- TronScan ---------------------------------------------------------------
# driver=http — реальные запросы (нужен ключ), driver=fake — фикстура без сети
TRONSCAN_DRIVER=fake
TRONSCAN_API_KEY=
TRONSCAN_BASE_URL=https://apilist.tronscanapi.com
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_TRC20_DECIMALS=6

TRONSCAN_TIMEOUT=15
TRONSCAN_CONNECT_TIMEOUT=5
TRONSCAN_RETRY_TIMES=3
TRONSCAN_RETRY_SLEEP_MS=500
TRONSCAN_PAGE_SIZE=50
TRONSCAN_MAX_PAGES=5

TRON_STRICT_ADDRESS_CHECKSUM=true

# --- Синхронизация ----------------------------------------------------------
DEPOSITS_SYNC_SCHEDULE_ENABLED=true
DEPOSITS_SYNC_CRON="*/5 * * * *"
MANUAL_SYNC_FOR_INACTIVE_WALLETS=true

# --- Демо-админ для сидера --------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
